---
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  /** Bajada bajo el título; por defecto se reutiliza la descripción. */
  lead?: string;
}

const { title, description, lead = description } = Astro.props;
---

{
  /*
  Encabezado común de las páginas de contenido: título, bajada y un ancho de
  medida acotado. Sin esto el texto se estiraba a todo el contenedor y costaba
  leerlo, que es lo que le pasaba a la página "Acerca".
*/
}
<BaseLayout {title} {description}>
  <header class="mb-10">
    <h1 class="text-3xl sm:text-4xl">{title}</h1>
    {lead && <p class="mt-3 max-w-2xl text-lg text-muted">{lead}</p>}
  </header>
  <slot />
</BaseLayout>
