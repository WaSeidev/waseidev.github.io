---
import BaseHead from "@/components/BaseHead.astro";
import NavHeader from "@/components/layouts/NavHeader.astro";
import Footer from "@/components/layouts/Footer.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

interface Props {
  title: string;
  description: string;
  image?: string;
  /** El currículum necesita todo el ancho para su rejilla de dos columnas. */
  wide?: boolean;
}

const { title, description, image, wide = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<html {lang}>
  <head>
    <BaseHead {title} {description} {image} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only rounded-md bg-brand px-4 py-2 text-brand-ink focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 print:hidden"
    >
      {t("nav.skipToContent")}
    </a>

    <NavHeader />

    <main
      id="main"
      class:list={[
        "mx-auto w-full flex-1 px-4 py-8 print:max-w-none print:p-0",
        wide ? "max-w-6xl" : "max-w-4xl",
      ]}
    >
      <slot />
    </main>

    <Footer />
  </body>
</html>
