---
import TitleCV from "./TitleCV.astro";

interface Props {
  resume: string;
  title: string;
}

const { resume, title } = Astro.props;
---

<section>
  <TitleCV>{title}</TitleCV>
  <p
    class="text-sm text-muted print:text-[9px] print:leading-snug print:text-black"
  >
    {resume}
  </p>
</section>
