---
import type { Skills } from "@/types/cv";
import TitleCV from "./TitleCV.astro";
import Pill from "@/components/Pill.astro";
import Icon from "../Icon.astro";

interface Props {
  skills: Skills[];
  title: string;
}
const { skills, title } = Astro.props;
---

<section>
  <TitleCV>{title}</TitleCV>
  <ul class="my-2 space-y-4">
    {
      skills.map((skill) => (
        <li>
          <div class="flex items-baseline gap-1">
            <h3 class="text-lg font-bold print:font-semibold print:text-lg">
              {skill.name}
            </h3>
            <h4 class="text-sm font-light print:text-md">{skill.level}</h4>
          </div>
          <ul class="flex flex-wrap gap-2 print:text-xs">
            {skill.keywords.map((keyword) => (
              <Pill>
                <Icon icon={keyword} />
                {keyword}
              </Pill>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</section>
