---
import type { Interests } from "@/types/cv";
import TitleCV from "./TitleCV.astro";
import Pill from "@/components/Pill.astro";

interface Props {
  interests: Interests[];
  title: string;
}

const { interests, title } = Astro.props;
---

<section>
  <TitleCV>{title}</TitleCV>
  {
    /* En dos columnas al imprimir: son entradas cortas y llenan mejor el ancho
      completo de la hoja que apiladas una debajo de otra. */
  }
  <ul
    class="space-y-3 print:grid print:grid-cols-2 print:gap-3 print:space-y-0"
  >
    {
      interests.map(({ name, keywords }) => (
        <li>
          <h3 class="text-sm font-extrabold print:text-[10px]">{name}</h3>
          <ul class="mt-1.5 flex flex-wrap gap-1.5 print:mt-1 print:gap-1">
            {keywords?.map((keyword) => (
              <Pill>{keyword}</Pill>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</section>
