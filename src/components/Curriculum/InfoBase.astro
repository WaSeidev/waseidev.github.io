---
import type { Basics } from "@/types/cv";
import ContactItem from "./ContactItem.astro";
import TitleCV from "./TitleCV.astro";
import { Icon } from "astro-icon/components";

interface Props {
  info: Basics;
  title: string;
}
const { info, title } = Astro.props;

const { postalCode, city, countryCode } = info.location;
// Se componía con expresiones sueltas en el marcado y salía "32005,Ourense,ES".
const address = [postalCode, city, countryCode].filter(Boolean).join(", ");
const mapsQuery = encodeURIComponent(`${postalCode} ${city} ${countryCode}`);
// El esquema sobra en pantalla, pero en papel el dominio debe verse completo.
const domain = (url: string) => url.replace(/^https?:\/\//, "");
---

<article>
  <TitleCV>{title}</TitleCV>
  <div class="flex items-center gap-4">
    <ContactItem icon="phone" href={`tel:${info.phone}`}
      >{info.phone}</ContactItem
    >
    <a
      class="print:hidden"
      href={`https://wa.me/${info.phone.replace("+", "").replaceAll(" ", "")}`}
      target="_blank"
      rel="noopener noreferrer nofollow"
    >
      <Icon
        name="whatsapp"
        class="h-5 w-5 text-gray-950 dark:text-gray-50 print:h-4 print:w-4 print:dark:text-gray-950"
      /></a
    >
  </div>
  <ContactItem
    icon="location"
    href={`https://www.google.com/maps/search/${mapsQuery}`}
  >
    {address}
  </ContactItem>
  <ContactItem icon="email" href={`mailto:${info.email}`}
    >{info.email}</ContactItem
  >
  <ContactItem icon="web" href={info.url}>{domain(info.url)}</ContactItem>
  {
    info.profiles?.map((profile) => (
      <ContactItem icon={profile.network.toLowerCase()} href={profile.url}>
        <span class="print:hidden">{profile.username}</span>
        <span class="hidden print:inline">{domain(profile.url)}</span>
      </ContactItem>
    ))
  }
</article>
