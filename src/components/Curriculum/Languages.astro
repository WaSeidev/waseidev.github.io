---
import type { Languages } from "@/types/cv";
import TitleCV from "./TitleCV.astro";

interface Props {
  languages: Languages[];
  title: string;
}

const { languages, title } = Astro.props;
---

{
  /* h3 y no h4: el título de sección ya es un h2, y saltarse un nivel rompe el
    orden de encabezados para quien navega con lector de pantalla. */
}
<section>
  <TitleCV>{title}</TitleCV>
  <ul>
    {
      languages.map(({ language, fluency }) => (
        <li class="inline-flex items-center gap-2">
          <h3 class="text-lg print:text-sm">{language}</h3>
          <span class="text-sm text-muted print:text-xs print:text-black">
            {fluency}
          </span>
        </li>
      ))
    }
  </ul>
</section>
