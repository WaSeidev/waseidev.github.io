---
import type { Basics } from "@/types/cv";
import { Image } from "astro:assets";
import Pill from "../Pill.astro";
import Icon from "../Icon.astro";

interface Props {
  basics: Basics;
}

const { basics } = Astro.props;
---

<section class="flex gap-7 flex-1">
  <div class="flex flex-col justify-center flex-1">
    <h1 class="w-full text-5xl mb-2 print:text-2xl font-semibold">
      {basics.name}
    </h1>
    <ul class="w-full text-lg print:text-sm font-light flex flex-wrap gap-2">
      {
        basics.label.split("|").map((label) => {
          return (
            <Pill classname="flex flex-row items-center gap-2">
              <Icon icon={label} />
              {label.toString().trim()}
            </Pill>
          );
        })
      }
    </ul>
  </div>
  <div class="flex">
    <Image
      src={basics.image}
      class="h-56 w-56 print:h-28 print:w-28 rounded-lg"
      alt={basics.name}
      width={300}
      height={300}
    />
  </div>
</section>
