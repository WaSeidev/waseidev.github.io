---
import type { Basics } from "@/types/cv";
import Pill from "../Pill.astro";
import Icon from "../Icon.astro";

interface Props {
  basics: Basics;
}

const { basics } = Astro.props;

// El label es una lista separada por "|": "Jr Developer | Astro | PHP | …".
const labels = basics.label
  .split("|")
  .map((label) => label.trim())
  .filter(Boolean);
---

{
  /*
  Sin fotografía a propósito. En buena parte de Europa el currículum se envía
  sin foto para reducir sesgos en la selección, y varias empresas la descartan
  de oficio. El espacio que libera se lo queda la experiencia.
*/
}
<section>
  <h1 class="text-3xl leading-tight print:text-lg">{basics.name}</h1>
  <ul class="mt-3 flex flex-wrap gap-1.5 print:mt-1.5 print:gap-1">
    {
      labels.map((label) => (
        <Pill>
          <Icon icon={label} />
          {label}
        </Pill>
      ))
    }
  </ul>
</section>
