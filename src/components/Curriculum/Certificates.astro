---
import type { Certificates } from "@/types/cv";
import TitleCV from "./TitleCV.astro";
import FormattedDate from "../FormattedDate.astro";

interface Props {
  certificates: Certificates[];
  title: string;
}

const { certificates, title } = Astro.props;
---

<section>
  <TitleCV>{title}</TitleCV>
  <ul class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
    {
      certificates.map((certificate) => (
        <a
          href={certificate.url}
          target="_blank"
          rel="noopener noreferrer nofollow"
        >
          <li class="flex flex-col justify-between rounded border p-2 print:border-2">
            <div class="flex justify-between">
              <h3 class="text-sm font-bold print:text-xs">
                {certificate.name}
              </h3>
              <span class="text-xs font-light text-nowrap">
                <FormattedDate date={certificate.date} />
              </span>
            </div>
            <p class="tex-sm font-light print:text-xs">{certificate.issuer}</p>
          </li>
        </a>
      ))
    }
  </ul>
</section>
