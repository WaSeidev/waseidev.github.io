---
import type { Certificates } from "@/types/cv";
import TitleCV from "./TitleCV.astro";
import FormattedDate from "../FormattedDate.astro";

interface Props {
  certificates: Certificates[];
  title: string;
}

const { certificates, title } = Astro.props;
---

<section>
  <TitleCV>{title}</TitleCV>

  {
    /*
    Dos maquetaciones para el mismo dato. En pantalla, cada certificado es un
    diploma en miniatura: doble filete, texto centrado y sello. En papel eso
    gastaría media hoja y tinta para nada, así que se sustituye por un listado
    de una línea. El `<a>` va DENTRO del `<li>`: al revés era HTML inválido,
    porque un `<ul>` solo admite `<li>` como hijo directo.
  */
  }
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 print:hidden">
    {
      certificates.map((certificate) => (
        <li class="relative">
          <a
            href={certificate.url}
            target="_blank"
            rel="noopener noreferrer nofollow"
            class="group flex h-full flex-col items-center rounded-card border border-line bg-surface p-5 text-center transition-colors hover:border-brand"
          >
            {/* Filete interior: el segundo trazo es lo que lo hace leer como
                un diploma y no como una tarjeta cualquiera. */}
            <span
              class="pointer-events-none absolute inset-[6px] rounded-[calc(var(--radius-card)-3px)] border border-line/70 transition-colors group-hover:border-brand/40"
              aria-hidden="true"
            />

            <span
              class="flex size-7 items-center justify-center rounded-full border border-brand/40 text-brand"
              aria-hidden="true"
            >
              <svg viewBox="0 0 20 20" fill="none" class="size-3.5">
                <path
                  d="M4 10.5 8 14.5 16 6"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>

            <h3 class="mt-3 text-sm leading-snug text-balance">
              {certificate.name}
            </h3>

            <span
              class="mt-2 h-px w-8 bg-line transition-colors group-hover:bg-brand/50"
              aria-hidden="true"
            />

            <p class="mt-2 text-xs tracking-wide text-muted uppercase">
              {certificate.issuer}
            </p>
            <p class="mt-auto pt-2 text-xs text-muted">
              <FormattedDate date={certificate.date} />
            </p>
          </a>
        </li>
      ))
    }
  </ul>

  <ul class="hidden print:block print:space-y-0.5">
    {
      certificates.map((certificate) => (
        <li class="flex items-baseline justify-between gap-2 print:text-[9px]">
          <span>
            <strong class="font-extrabold">{certificate.name}</strong>
            <span class="text-black/70"> · {certificate.issuer}</span>
          </span>
          <span class="whitespace-nowrap text-black/70">
            <FormattedDate date={certificate.date} />
          </span>
        </li>
      ))
    }
  </ul>
</section>
