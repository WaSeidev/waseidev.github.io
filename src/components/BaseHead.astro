---
import { Font } from "astro:assets";
import {
  languages,
  defaultLang,
  getLangFromUrl,
  getLocalizedUrl,
  type Lang,
} from "@/i18n/utils";
import { cvByLang } from "@/data/cv";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const lang = getLangFromUrl(Astro.url);

// El sufijo se añade aquí y no en cada página: componerlo en el sitio de la
// llamada hacía que /about, /setup, /blog y /projects salieran sin el nombre
// mientras / y /cv sí lo llevaban.
const author = cvByLang[lang].basics.name;
const fullTitle = title.includes(author) ? title : `${title} | ${author}`;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Las portadas del CV y del blog llegan como ruta de public/; las externas ya
// son absolutas y `new URL` las respeta tal cual.
// Banner de marca en 1200x630, la proporción que esperan las redes. Las
// entradas con portada propia la pasan por props y esta queda de reserva.
const ogImage = new URL(image ?? "/assets/images/waseidev-og.webp", Astro.site);
const noindex = import.meta.env.PUBLIC_NOINDEX === "true";

const withBase = (path: string) =>
  `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${path.replace(/^\//, "")}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />

{
  /* Cada familia necesita su propio <Font>: es quien inyecta los @font-face.
    Solo se precarga Raleway, que es la del cuerpo y entra en el primer
    pintado; Coda es de titulares y puede llegar un instante después. */
}
<Font cssVariable="--font-raleway" preload />
<Font cssVariable="--font-coda" />

<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

{
  (Object.keys(languages) as Lang[]).map((l) => (
    <link
      rel="alternate"
      hreflang={l}
      href={new URL(getLocalizedUrl(Astro.url, l), Astro.site)}
    />
  ))
}
{
  /* x-default: qué versión servir a quien no coincide con ningún idioma
    declarado. Sin esto Google decide por su cuenta. */
}
<link
  rel="alternate"
  hreflang="x-default"
  href={new URL(getLocalizedUrl(Astro.url, defaultLang), Astro.site)}
/>

<meta property="og:type" content="website" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:locale" content={lang} />
<meta property="og:image" content={ogImage} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@waseidev" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{/* Corre antes del primer pintado para que no haya destello de tema claro. */}
<script is:inline>
  (() => {
    const applyTheme = () => {
      const stored = localStorage.getItem("theme");
      const dark = stored
        ? stored === "dark"
        : window.matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.classList.toggle("dark", dark);
    };
    applyTheme();
    document.addEventListener("astro:after-swap", applyTheme);
  })();
</script>
