---
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { Basics } from "@/types/cv";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

interface Props {
  basics: Basics;
}

const { basics } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// El label es una lista separada por "|": el primero es el puesto y hace de
// antetítulo; el resto son tecnologías y viven en su propia sección.
const [role] = basics.label.split("|").map((label) => label.trim());
---

<section
  class="flex flex-col-reverse items-center gap-8 py-6 md:flex-row md:justify-between md:py-10"
>
  <div class="min-w-0 text-center md:text-left">
    <h1 class="text-4xl sm:text-5xl">{basics.name}</h1>

    <p class="mt-2 text-lg font-semibold text-brand">{role}</p>

    <div class="mt-8 flex flex-wrap justify-center gap-3 md:justify-start">
      <a
        href={getRelativeLocaleUrl(lang, "cv")}
        class="rounded-md bg-brand px-5 py-2.5 font-extrabold text-brand-ink transition-opacity hover:opacity-90"
      >
        {t("content.visit_my_cv")}
      </a>
      <a
        href={`mailto:${basics.email}`}
        class="rounded-md border border-line px-5 py-2.5 font-extrabold transition-colors hover:border-brand"
      >
        {t("content.email_me")}
      </a>
    </div>
  </div>

  <Image
    src={basics.image}
    width={400}
    height={400}
    class="size-40 shrink-0 rounded-full object-cover sm:size-52"
    alt={basics.name}
  />
</section>
