---
import FormattedDate from "./FormattedDate.astro";

interface Props {
  post: {
    title: string;
    description: string;
    pubDate: Date;
    heroImage?: string;
  };
  slug: string;
}

const { post, slug } = Astro.props;
const image = post.heroImage ?? "/assets/images/blog/blog-placeholder-1.jpg";
---

<article
  class="group relative flex flex-col overflow-hidden rounded-card border border-line bg-surface transition-colors hover:border-brand"
>
  <img
    class="aspect-video w-full object-cover"
    src={image}
    alt=""
    loading="lazy"
    decoding="async"
  />
  <div class="flex flex-1 flex-col p-4">
    <h2 class="text-lg">
      <a
        href={slug}
        class="group-hover:text-brand after:absolute after:inset-0"
      >
        {post.title}
      </a>
    </h2>
    <p class="mt-1 text-sm text-muted">
      <FormattedDate date={post.pubDate} />
    </p>
    <p class="mt-2 flex-1 text-muted">{post.description}</p>
  </div>
</article>
