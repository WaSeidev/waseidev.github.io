---
import { Image } from "astro:assets";
import FormattedDate from "@/components/FormattedDate.astro";

interface Props {
  href: string;
  title: string;
  date: string | Date;
  description: string;
  image?: string;
}

const {
  href,
  title,
  date,
  description,
  image = "/assets/images/blog/blog-placeholder-1.jpg",
} = Astro.props;

// Los proyectos del CV traen enlaces externos; el blog, rutas internas.
const isExternal = /^https?:\/\//.test(href);
---

<article
  class="group relative flex flex-col overflow-hidden rounded-card border border-line bg-surface transition-colors hover:border-brand"
>
  <Image
    width={400}
    height={225}
    src={image}
    alt=""
    class="aspect-video w-full object-cover"
  />
  <div class="flex flex-1 flex-col p-4">
    <h3 class="text-lg">
      <a
        {href}
        target={isExternal ? "_blank" : undefined}
        rel={isExternal ? "noopener" : undefined}
        class="group-hover:text-brand after:absolute after:inset-0"
      >
        {title}
      </a>
    </h3>
    <p class="mt-1 text-sm text-muted"><FormattedDate {date} /></p>
    <p class="mt-2 flex-1 text-muted">{description}</p>
  </div>
</article>
