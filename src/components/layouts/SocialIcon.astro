---
import { Icon } from "astro-icon/components";
interface Props {
  name: string;
  href: string;
}
const { name, href } = Astro.props;
---

<li class="flex items-center justify-center">
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer nofollow"
    class="group rounded bg-gray-50 p-1 transition-shadow duration-300 ease-in-out hover:shadow dark:bg-gray-700 dark:text-gray-50"
  >
    {
      /* Los logos de marca traen su propio color fijo en el SVG (no
      currentColor), así que desentonaban con la paleta del sitio. Mismo
      tratamiento que las pastillas: en gris hasta que se pasa el ratón. */
    }
    <Icon
      name={name}
      class="h-5 w-5 grayscale transition-all duration-300 group-hover:grayscale-0"
    />
  </a>
</li>
