---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLangFromUrl, getPathWithoutLocale } from "@/i18n/utils";

interface Props {
  /** Ruta lógica sin idioma ni base: "", "blog", "projects"… */
  path: string;
  class?: string;
}

const { path, class: className } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const href = getRelativeLocaleUrl(lang, path);

// Una entrada de blog debe marcar "blog" como activo, de ahí el startsWith.
const current = getPathWithoutLocale(Astro.url);
const isActive =
  current === path || (path !== "" && current.startsWith(`${path}/`));
---

<li>
  <a
    {href}
    aria-current={isActive ? "page" : undefined}
    class:list={[
      "block rounded-md px-3 py-1 text-muted transition-colors hover:text-ink aria-[current=page]:font-extrabold aria-[current=page]:text-ink",
      className,
    ]}
  >
    <slot />
  </a>
</li>
