---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";
import NavLink from "@/components/layouts/NavLink.astro";
import LanguagePicker from "@/components/layouts/LanguagePicker.astro";
import ToggleTheme from "@/components/layouts/ToggleTheme.astro";
import { getLangFromUrl, useTranslations, type UIKey } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links: { path: string; key: UIKey }[] = [
  { path: "", key: "nav.home" },
  { path: "cv", key: "nav.cv" },
  { path: "projects", key: "nav.projects" },
  { path: "blog", key: "nav.blog" },
  { path: "about", key: "nav.about" },
];
---

<header
  class="sticky top-0 z-40 border-b border-line bg-canvas/85 backdrop-blur print:hidden"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">
    <a
      href={getRelativeLocaleUrl(lang, "")}
      class="text-lg font-extrabold tracking-tight text-ink"
    >
      WaSeidev
    </a>

    <nav aria-label={t("nav.primary")} class="hidden items-center md:flex">
      <ul class="flex items-center gap-1">
        {links.map(({ path, key }) => <NavLink {path}>{t(key)}</NavLink>)}
      </ul>
      <div class="ml-3 flex items-center gap-2 border-l border-line pl-3">
        <LanguagePicker />
        <ToggleTheme />
      </div>
    </nav>

    <div class="flex items-center gap-2 md:hidden">
      <LanguagePicker />
      <ToggleTheme />
      <button
        id="menuBtn"
        type="button"
        aria-expanded="false"
        aria-controls="menu"
        class="cursor-pointer rounded-md border border-line p-1.5 text-muted transition-colors hover:border-brand hover:text-ink"
      >
        <span class="sr-only">{t("nav.openMenu")}</span>
        <Icon name="menu" class="size-5" aria-hidden="true" />
      </button>
    </div>
  </div>

  <nav
    id="menu"
    aria-label={t("nav.primary")}
    hidden
    class="border-t border-line px-4 pb-4 md:hidden"
  >
    <ul class="flex flex-col">
      {
        links.map(({ path, key }) => (
          <NavLink {path} class="py-3 text-base">
            {t(key)}
          </NavLink>
        ))
      }
    </ul>
  </nav>
</header>

{
  /*
  Delegación en `document` en vez de un listener sobre el botón: así el menú
  sigue respondiendo tras cada navegación sin volver a registrar listeners.
*/
}
<script>
  const setOpen = (open: boolean) => {
    document
      .getElementById("menuBtn")
      ?.setAttribute("aria-expanded", String(open));
    document.getElementById("menu")?.toggleAttribute("hidden", !open);
  };

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement | null;
    if (!target?.closest("#menuBtn")) return;

    const isOpen =
      document.getElementById("menuBtn")?.getAttribute("aria-expanded") ===
      "true";
    setOpen(!isOpen);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setOpen(false);
  });
</script>
