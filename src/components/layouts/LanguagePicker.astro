---
import {
  languages,
  getLangFromUrl,
  getLocalizedUrl,
  useTranslations,
  type Lang,
} from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Solo hay dos idiomas, así que el selector es un enlace directo al otro.
const other = (Object.keys(languages) as Lang[]).find((l) => l !== lang)!;
---

<a
  href={getLocalizedUrl(Astro.url, other)}
  hreflang={other}
  class="rounded-md border border-line px-2 py-1 text-sm text-muted transition-colors hover:border-brand hover:text-ink"
>
  <span class="sr-only">{t("lang.switchTo")}</span>
  <span aria-hidden="true">{other.toUpperCase()}</span>
</a>
