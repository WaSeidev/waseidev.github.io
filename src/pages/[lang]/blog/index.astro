---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import PostCard from "@/components/PostCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getLocalePaths, useTranslations, type Lang } from "@/i18n/utils";

export const getStaticPaths = getLocalePaths;

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = (
  await getCollection(
    "blog",
    (post) => post.data.lang === lang && !post.data.draft,
  )
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={t("content.blog")} description={t("content.blog")}>
  <h1 class="mb-8 text-3xl sm:text-4xl">{t("content.blog")}</h1>
  {
    posts.length > 0 ? (
      <section class="grid grid-cols-[repeat(auto-fill,minmax(280px,320px))] gap-4">
        {posts.map((post) => (
          <PostCard
            post={post.data}
            slug={getRelativeLocaleUrl(lang, `blog/${post.id}`)}
          />
        ))}
      </section>
    ) : (
      <p class="text-muted">{t("content.empty")}</p>
    )
  }
</BaseLayout>
