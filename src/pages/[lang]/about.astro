---
import PageLayout from "@/layouts/PageLayout.astro";
import { cvByLang } from "@/data/cv";
import { getLocalePaths, useTranslations, type Lang } from "@/i18n/utils";

export const getStaticPaths = getLocalePaths;

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const cv = cvByLang[lang];
---

{
  /*
  El texto es el `summary` del CV, así que hay una sola fuente para esa
  descripción: la que se ve aquí es la misma que se imprime en el currículum.
*/
}
<PageLayout
  title={t("content.about")}
  description={cv.basics.summary}
  lead={cv.basics.label.split("|")[0]?.trim()}
>
  <div class="max-w-2xl space-y-4 text-lg text-muted">
    <p>{cv.basics.summary}</p>
  </div>
</PageLayout>
