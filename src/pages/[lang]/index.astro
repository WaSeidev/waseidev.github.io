---
import IndexPage from "@/components/pages/IndexPage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { cvByLang } from "@/data/cv";
import { getLocalePaths, type Lang } from "@/i18n/utils";

export const getStaticPaths = getLocalePaths;

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const cv = cvByLang[lang];
---

<BaseLayout title="Portfolio" description={cv.basics.label}>
  <IndexPage {cv} />
</BaseLayout>
