---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CurriculumLayout from "@/layouts/CurriculumLayout.astro";
import { cvByLang } from "@/data/cv";
import { getLocalePaths, useTranslations, type Lang } from "@/i18n/utils";

export const getStaticPaths = getLocalePaths;

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const cv = cvByLang[lang];
---

<BaseLayout title={t("nav.cv")} description={cv.basics.summary} wide>
  <CurriculumLayout {cv} />
</BaseLayout>
