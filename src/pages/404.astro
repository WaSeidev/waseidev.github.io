---
import { getRelativeLocaleUrl } from "astro:i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { defaultLang, useTranslations } from "@/i18n/utils";

// La 404 se sirve para cualquier ruta, así que no puede deducir el idioma de
// la URL: se queda en el idioma por defecto.
const t = useTranslations(defaultLang);
---

<BaseLayout title={t("notFound.title")} description={t("notFound.description")}>
  <div class="py-16 text-center">
    <p class="text-sm font-extrabold tracking-wide text-brand uppercase">404</p>
    <h1 class="mt-3 text-3xl sm:text-4xl">{t("notFound.title")}</h1>
    <p class="mx-auto mt-4 max-w-md text-muted">{t("notFound.description")}</p>
    <a
      href={getRelativeLocaleUrl(defaultLang, "")}
      class="mt-8 inline-block rounded-md bg-brand px-5 py-2.5 font-extrabold text-brand-ink transition-opacity hover:opacity-90"
    >
      {t("notFound.back")}
    </a>
  </div>
</BaseLayout>
